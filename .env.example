# Placeholder reference only; Django does not automatically load this file.
# Set these values through your local shell or production environment.
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=example.com,www.example.com

DB_NAME=wbpsc_mock_platform
DB_USER=wbpsc_app
DB_PASSWORD=replace-with-a-database-password
DB_HOST=127.0.0.1
DB_PORT=5432

# Optional on the OCI instance only: private bucket for scheduled backups.
# The backup service authenticates with the OCI instance principal, not API keys.
OCI_BUCKET_NAME=replace-with-private-backup-bucket
OCI_REGION=replace-with-oci-region

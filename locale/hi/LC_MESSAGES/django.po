msgid "Footer navigation"
msgstr "फ़ुटर नेविगेशन"

msgid "Free resources and practice to support your WBPSC preparation."
msgstr "आपकी WBPSC तैयारी के लिए निःशुल्क सामग्री और अभ्यास।"

msgid "Your preparation, one step at a time"
msgstr "आपकी तैयारी, एक-एक कदम आगे"

msgid "Build confidence for your next WBPSC exam"
msgstr "अपनी अगली WBPSC परीक्षा के लिए आत्मविश्वास बढ़ाएँ"

msgid "Browse free study materials and practise with timed mock tests, all in one place."
msgstr "एक ही जगह निःशुल्क अध्ययन सामग्री देखें और समयबद्ध मॉक टेस्ट का अभ्यास करें।"

msgid "Explore study materials"
msgstr "अध्ययन सामग्री देखें"

msgid "View mock tests"
msgstr "मॉक टेस्ट देखें"

msgid "Ways to prepare"
msgstr "तैयारी के तरीके"

msgid "Study at your pace"
msgstr "अपनी गति से पढ़ें"

msgid "Browse by examination and subject"
msgstr "परीक्षा और विषय के अनुसार देखें"

msgid "Review previous-year paper demonstrations"
msgstr "पिछले वर्षों के प्रश्नपत्रों के नमूने देखें"

msgid "Track your own mock-test attempts"
msgstr "अपने मॉक टेस्ट प्रयासों की प्रगति देखें"

msgid "Choose where to begin"
msgstr "शुरुआत करने के लिए चुनें"

msgid "Free learning"
msgstr "निःशुल्क अध्ययन"

msgid "Study materials"
msgstr "अध्ययन सामग्री"

msgid "Find published resources and browse papers by exam and subject."
msgstr "प्रकाशित सामग्री खोजें और परीक्षा तथा विषय के अनुसार प्रश्नपत्र देखें।"

msgid "Practice"
msgstr "अभ्यास"

msgid "Try timed examinations and review your results after submission."
msgstr "समयबद्ध परीक्षा दें और जमा करने के बाद परिणाम देखें।"

msgid "Your progress"
msgstr "आपकी प्रगति"

msgid "My attempts"
msgstr "मेरे प्रयास"

msgid "Return to your account and see your examination history."
msgstr "अपने खाते में लौटें और परीक्षा इतिहास देखें।"

msgid "Create a student account"
msgstr "विद्यार्थी खाता बनाएँ"

msgid "Register to save answers and keep your mock-test history."
msgstr "उत्तर सहेजने और मॉक टेस्ट इतिहास रखने के लिए पंजीकरण करें।"

msgid "Timed practice"
msgstr "समयबद्ध अभ्यास"

msgid "WBPSC Mock Tests | Online Exam Practice"
msgstr "WBPSC मॉक टेस्ट | ऑनलाइन परीक्षा अभ्यास"

msgid "Browse available WBPSC mock tests. Practise with timed examinations and review results after submission."
msgstr "उपलब्ध WBPSC मॉक टेस्ट देखें। समयबद्ध परीक्षा का अभ्यास करें और जमा करने के बाद परिणाम देखें।"

msgid "Browse available WBPSC mock tests and practise online."
msgstr "उपलब्ध WBPSC मॉक टेस्ट देखें और ऑनलाइन अभ्यास करें।"

msgid "Minutes"
msgstr "मिनट"

msgid "minutes"
msgstr "मिनट"

msgid "Available languages:"
msgstr "उपलब्ध भाषाएँ:"

